# ==============================================================================
# ENVIRONMENT VARIABLES: SCHEDULER UPLOADER
# ==============================================================================
# Salin file ini menjadi .env lalu sesuaikan nilainya.
# Di Heroku, atur variabel-variabel ini pada menu Settings -> Config Vars.

# ------------------------------------------------------------------------------
# 1. GOOGLE DRIVE CREDENTIALS & FOLDER
# ------------------------------------------------------------------------------
# GDRIVE_TOKEN dapat berupa:
#   a) String JSON kredensial OAuth2 (isi file token.json: {"client_id": "...", "client_secret": "...", "refresh_token": "..."})
#   b) Path ke file kredensial lokal (contoh: ./token.json atau ../token.json)
#   c) String Refresh Token OAuth Google langsung
GDRIVE_TOKEN=

# ID Folder 'Unused' di Google Drive tempat folder-folder game / stream klip baru disimpan
GDRIVE_UNUSED_FOLDER_ID=

# ID Folder 'Used' di Google Drive tempat video yang sudah berhasil terupload dipindahkan secara instan
GDRIVE_USED_FOLDER_ID=

# ID Folder 'Doksli' di Google Drive tempat kumpulan subfolder momen doksli disimpan
# Digunakan oleh script auto-edit kompilasi tebak-tebakan: `npm run doksli`
GDRIVE_DOKSLI_FOLDER_ID=

# (Opsional) ID Folder Google Drive tujuan hasil video kompilasi otomatis diunggah
# Jika diisi, video hasil kompilasi akan otomatis di-upload ke GDrive dan file video lokal dihapus
GDRIVE_RESULT_FOLDER_ID=

# (Opsional) Jumlah klip doksli yang diacak untuk 1 video kompilasi (default: 5, rentang: 5 - 10)
QUIZ_CLIP_COUNT=5

# (Opsional) Jarak keunikan game (jeda berapa klip berturut-turut sebelum game yang sama boleh terpilih lagi):
# - 5 (atau >= jumlah klip): Dalam 5 klip berturut-turut dijamin tidak ada duplikat game (semua momen game berbeda).
# - 1: Bebas duplikat (game yang sama boleh muncul berturut-turut di klip berikutnya jika memiliki klip/episode lain).
# - 2, 3, dst: Game yang sama baru boleh muncul kembali setelah jeda 2 atau 3 klip.
# Default: 5
GAME_UNIQUE_WINDOW=5

# (Opsional) Mode Kompilasi Edisi Khusus 1 Game (default: false / multi-game acak)
# - Set SINGLE_GAME_MODE=true untuk mengaktifkan edisi 1 game (pilih game via menu interaktif terminal)
# - Atau tentukan nama game langsung via SINGLE_GAME_NAME="Resident Evil 4"
# - Atau tentukan ID folder game via SINGLE_GAME_FOLDER_ID="<id_folder_game>"
# - Bisa juga dijalankan via CLI: node compile_doksli.js --single-game --game="GTA San Andreas"
# Pada mode edisi 1 game:
#   * Opsi pilihan ganda kuis otomatis berganti menjadi Nama Episode (subfolder lapis ke-2).
#   * Jarak keunikan GAME_UNIQUE_WINDOW berlaku pada keunikan Episode.
#   * Jika game bertipe non-episode / single-stream ('-') dan GAME_UNIQUE_WINDOW > 1, program early fail.
# SINGLE_GAME_MODE=false
# SINGLE_GAME_NAME=""
# SINGLE_GAME_FOLDER_ID=""

# (Opsional) Offset vertikal posisi elemen kuis (teks, countdown, kartu opsi) di dalam area gameplay 2:3
# Catatan: Background layer gelap tetap terkunci presisi di batas area gameplay (Y ~ 1006px s/d 1726px) agar sensor gameplay tidak bocor & Facecam atas tidak tertutup
QUIZ_OFFSET_Y=0

# (Opsional) Teks pertanyaan kuis tebak-tebakan (default: 'Game apakah ini?')
QUIZ_QUESTION="Game apakah ini?"

# (Opsional) Posisi Y teks nama file video full (default: 480 = 1/4 tinggi kanvas portrait 1080x1920)
MEME_TEXT_Y=480

# (Opsional) Path file efek suara untuk transisi layar hitam antar momen (default: otomatis mendeteksi 'tiktok core.mp3')
TRANSITION_SFX_PATH="tiktok core.mp3"

# (Opsional) Mode visual layar transisi / penutup momen TikTok Core:
# - 'number' : (Default) Menampilkan teks counter urutan kuis "x / y" di tengah layar hitam.
# - 'meme'   : Menampilkan gambar meme facecam 1:1 selebar setengah portrait (540x540px) di tengah layar.
#              Gambar (.png / .jpg) opsional diletakkan di setiap folder momen di GDrive.
#              Jika tidak ada gambar pada momen tersebut, layar tetap hitam polos (tidak diskip).
# - 'off'    : Layar hitam polos bersih tanpa teks maupun gambar.
TRANSITION_MODE=number

# (Opsional) Tampilkan teks counter 'x / y' di tengah layar transisi (default: true jika TRANSITION_MODE tidak diatur)
# Jika diset false (atau TRANSITION_FONT_SIZE=0), sama dengan TRANSITION_MODE=off
TRANSITION_SHOW_COUNTER=true

# (Opsional) Ukuran font teks counter transisi 'x / y' di tengah layar hitam antar momen (default: 72)
TRANSITION_FONT_SIZE=72

# (Opsional) Kecepatan per tick countdown kuis dalam detik (default: 0.5s = 1.5s countdown + 0.5s reveal = 2.0s total freeze)
QUIZ_TICK_SECONDS=0.5

# (Opsional) Path berkas audio efek suara (SFX) kuis:
# - QUIZ_TICK_SFX_PATH: Efek suara tick / beep countdown 3-2-1 (default: sintesis nada marimba akustik D5 hangat & halus, bebas bising)
# - QUIZ_CORRECT_SFX_PATH: Efek suara lonceng jawaban benar (default: sintesis arpeggio C6-E6-G6 elegan dengan volume diperhalus ~55%)
# Anda dapat memasukkan file MP3/WAV bebas hak cipta dari online atau lokal.
# Program juga otomatis mendeteksi berkas 'quiz_tick.mp3'/'tick.mp3' dan 'quiz_correct.mp3'/'correct.mp3' jika diletakkan di folder kerja.
# QUIZ_TICK_SFX_PATH="quiz_tick.mp3"
# QUIZ_CORRECT_SFX_PATH="quiz_correct.mp3"

# (Opsional) Kecepatan pemutaran video full meme:
# - Angka >= 1.0 (misal: 1.0, 1.5, 2.0): Kecepatan tetap (default: 1.0 = normal).
# - 'auto': Otomatis kalkulasi percepatan jika durasi video full > 5 detik agar menjadi 5 detik (dinamis per klip). Jika durasi awal <= 5 detik, kecepatan tetap normal 1.0x.
# Jika video dipercepat (> 1.0), audio otomatis mengikuti dengan nada tinggi / cempreng (pitch naik).
FULL_VIDEO_SPEED=1.0

# (Opsional) Target durasi maksimal video full dalam detik jika FULL_VIDEO_SPEED=auto (default: 5.0)
FULL_VIDEO_MAX_DURATION=5.0

# (Opsional) Mode Roulette: Durasi animasi putaran roulette dalam detik (default: 4.4)
# Termasuk fase perlambatan deselerasi (~82% durasi) dan lock jeda berhenti kartu pemenang (~18% durasi).
ROULETTE_SPIN_DURATION=4.4

# (Opsional) Mode Roulette: Durasi transisi freeze fade-in dan freeze fade-out video speedup dalam detik (default: 0.5)
# Frame awal & akhir video ditahan (freeze still frame) selama durasi ini sambil ber-transisi fade di atas papan roulette.
ROULETTE_FADE_DURATION=0.5

# (Opsional) Kode awalan skip untuk mengabaikan folder/file yang rusak / sedang diedit ulang (default: '!')
# Folder atau berkas yang diawali kode ini (misal: '!Minecraft', '!eps 1', '!cut.mp4') otomatis dilewati
SKIP_PREFIX="!"

# (Opsional) Sensor / Sensor Gameplay pada Video Cut & Kuis (agar tidak menjadi contekan)
# CENSOR_GAMEPLAY=true
# CENSOR_MODE=pixelate            # 'pixelate' (mosaik piksel kotak-kotak) atau 'blur' (buram halus)
# CENSOR_GAMEPLAY_Y=1006         # Posisi Y awal gameplay (default: 1006 untuk kanvas 1080x1920)
# CENSOR_GAMEPLAY_H=720          # Tinggi area gameplay (default: 720)
# CENSOR_PIXEL_SIZE=45           # Ukuran piksel mosaik jika CENSOR_MODE=pixelate (default: 45)
# CENSOR_BLUR_RADIUS=28          # Radius blur jika CENSOR_MODE=blur (default: 28)

# Mode Antrean:
# - 'random'   : (Default) Acak folder game/stream, acak klip, lalu pindahkan & rename ke folder used.
# - 'schedule' : Cari folder tanggal (YYYY-MM-DD) dan jam target (HH_00.mp4).
QUEUE_MODE=random

# (Opsional) Jika GDRIVE_TOKEN hanya berupa refresh token biasa, masukkan Client ID & Secret berikut:
# GDRIVE_CLIENT_ID=
# GDRIVE_CLIENT_SECRET=


# ------------------------------------------------------------------------------
# 2. YOUTUBE API CREDENTIALS
# ------------------------------------------------------------------------------
# Kredensial untuk YouTube Data API v3 (dengan scope youtube.upload).
# Dapat berupa string JSON OAuth2 atau string refresh token.
# Catatan: Jika dikosongkan, script akan mencoba menggunakan GDRIVE_TOKEN jika akun Google-nya sama dan memiliki scope YouTube.
YOUTUBE_API_TOKEN=

# (Opsional) Pengaturan default status privasi video YouTube ('public', 'unlisted', atau 'private')
# Default: public
YOUTUBE_PRIVACY_STATUS=public


# ------------------------------------------------------------------------------
# 3. TIKTOK API CREDENTIALS
# ------------------------------------------------------------------------------
# Client Key & Secret dari TikTok Developer Portal (Sandbox / Production)
# Digunakan oleh script `npm run auth:tiktok` untuk menghasilkan TIKTOK_API_TOKEN otomatis
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Access Token untuk TikTok Content Posting API (v2 / Direct Post).
# (Dapat diisi otomatis oleh script `npm run auth:tiktok`)
TIKTOK_API_TOKEN=

# (Opsional) Pengaturan privasi TikTok:
# Pilihan: 'PUBLIC_TO_EVERYONE', 'MUTUAL_FOLLOW_FRIENDS', 'FOLLOWER_OF_CREATOR', 'SELF_ONLY'
# Default: PUBLIC_TO_EVERYONE
TIKTOK_PRIVACY_LEVEL=PUBLIC_TO_EVERYONE


# ------------------------------------------------------------------------------
# 4. OVERRIDE & TESTING CONFIGURATION (OPSIONAL)
# ------------------------------------------------------------------------------
# Digunakan jika ingin menguji jadwal tertentu secara manual tanpa menunggu jam sebenarnya.
# TARGET_DATE=2026-10-23
# TARGET_HOUR=17

# Set ke 'true' untuk menyimulasikan download & upload tanpa mengirim HTTP request ke YouTube & TikTok API
# MOCK_UPLOAD=false
